# Copier en .env (jamais committé). Tout est optionnel : le projet tourne sans aucune clé.

LLM_BACKEND=ollama            # ollama | openai_compatible | hf | mock
DATA_SOURCE=yfinance          # yfinance | synthetic
OLLAMA_HOST=http://localhost:11434

# Serveur auto-hébergé compatible OpenAI (si LLM_BACKEND=openai_compatible)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_API_KEY=none
LLM_RAPIDE_MODEL=Qwen/Qwen2.5-3B-Instruct
LLM_FORT_MODEL=Qwen/Qwen2.5-7B-Instruct

# Recherche web : Tavily (offre gratuite limitée) ; sinon DuckDuckGo sans clé
TAVILY_API_KEY=

# Checkpointer PostgreSQL (settings.yaml -> graphe.checkpointer: postgres)
POSTGRES_URI=postgresql://user:password@localhost:5432/portfolio

# Observabilité LangSmith (optionnel ; alternative open source : Langfuse auto-hébergé)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=portfolio-agents
